# Frontend (build statis) + Caddy. Build context = root repo:
#   docker build -f deploy/Dockerfile.web .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Same-origin: string kosong = frontend memanggil /api dan /socket.io di domain yang sama.
# VITE_SHOW_DEMO_ACCOUNTS sengaja TIDAK diset (akun demo tidak tampil di halaman Masuk).
ENV VITE_API_BASE_URL=""
# Opsional: kunci OpenRouteService (tanpa ini jarak dihitung Haversine). Kunci ini terlihat di browser, pakai kunci khusus & batasi domain.
ARG VITE_OPENROUTESERVICE_API_KEY=
ENV VITE_OPENROUTESERVICE_API_KEY=${VITE_OPENROUTESERVICE_API_KEY}
RUN npm run build \
 && ! find dist -name '*.map' | grep -q .

FROM caddy:2
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
