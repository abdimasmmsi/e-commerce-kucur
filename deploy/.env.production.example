# Salin ke deploy/.env.production lalu isi. JANGAN commit file .env.production (sudah di-ignore git).
#   cp deploy/.env.production.example deploy/.env.production
#
# Buat kata sandi acak (hex, aman dipakai di URL tanpa tanda kutip):
#   openssl rand -hex 24
# (jalankan sekali untuk tiap kata sandi di bawah; jangan pakai kata sandi yang sama)

# Domain tanpa https:// (A record domain harus sudah mengarah ke IP VPS). Uji lokal: localhost
SITE_ADDRESS=toko.contoh.id

# Kata sandi MySQL. DATABASE_URL disusun otomatis oleh docker-compose, tidak perlu diisi.
MYSQL_ROOT_PASSWORD=GANTI_hasil_openssl_rand_hex_24
MYSQL_PASSWORD=GANTI_hasil_openssl_rand_hex_24

# Zona waktu (memengaruhi jam batas pesan/pengiriman di server).
TZ=Asia/Jakarta

# Opsional. Kosong = https://SITE_ADDRESS. Isi hanya jika frontend diakses dari origin lain / port lain.
CORS_ALLOWED_ORIGINS=

# Opsional: notifikasi push. Buat sekali: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@contoh.desa

# Opsional: Midtrans (kosong = pembayaran online membalas PAYMENT_PROVIDER_NOT_CONFIGURED, COD tetap jalan)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Opsional: kunci OpenRouteService untuk jarak jalan (kosong = hitung garis lurus Haversine). Terlihat di browser; batasi ke domain.
OPENROUTESERVICE_API_KEY=

# Hanya untuk uji lokal (bentrok port). Produksi biarkan default 80/443.
# HTTP_PORT=8080
# HTTPS_PORT=8443
