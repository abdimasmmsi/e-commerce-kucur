# Image backend Kucur (Express + Prisma). Build context = root repo:
#   docker build -f deploy/Dockerfile.backend .
FROM node:22-bookworm-slim

# Prisma membutuhkan openssl; tini meneruskan sinyal stop dengan benar.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
# Dependensi produksi saja. CLI prisma (devDependency) dipasang terpisah, versi sama dengan lockfile,
# karena dibutuhkan untuk "prisma migrate deploy" saat container start.
ARG PRISMA_VERSION=6.19.3
RUN npm ci --omit=dev --no-audit --no-fund \
 && npm install --no-save --no-audit --no-fund prisma@${PRISMA_VERSION}

COPY backend/prisma ./prisma
RUN npx prisma generate

COPY backend/ ./
# Folder uploads = volume. Dibuat dan dimiliki user "node" supaya volume baru bisa ditulis.
RUN mkdir -p /app/uploads/proofs /app/uploads/profiles && chown -R node:node /app
USER node

VOLUME ["/app/uploads"]
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
# Terapkan migrasi yang sudah ada (tidak membuat migrasi baru), lalu jalankan server.
CMD ["sh", "-c", "npx prisma migrate deploy && exec node server.js"]
