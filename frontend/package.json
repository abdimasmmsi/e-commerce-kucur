{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:encoding": "node scripts/check-encoding.mjs",
    "lint": "npm run check:encoding && node scripts/check-faq.mjs && eslint .",
