MIDTRANS_SERVER_KEY=PLACEHOLDER
MIDTRANS_CLIENT_KEY=PLACEHOLDER
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_PAYMENT_EXPIRY_MINUTES=30
MIDTRANS_NOTIFICATION_URL=https://your-public-backend.example/api/payments/midtrans/notification
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=mysql://kucur:PASSWORD@127.0.0.1:3307/kucur
TEST_DATABASE_URL=mysql://kucur:PASSWORD@127.0.0.1:3307/kucur_test
AUTH_SESSION_TTL_HOURS=12
# Server di belakang proxy (Caddy/Nginx): isi "uniquelocal" (jaringan Docker/privat) atau jumlah hop, mis. 1. Kosong = hanya loopback dipercaya.
TRUST_PROXY=
# Produksi: NODE_ENV=production dan CORS_ALLOWED_ORIGINS=https://domain-kamu (tanpa localhost).
# Development seed only. Do not reuse this value in production.
DEV_SEED_PASSWORD=CHANGE_ME_FOR_LOCAL_QA

# Notifikasi push (VAPID). Buat sendiri: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@contoh.desa
