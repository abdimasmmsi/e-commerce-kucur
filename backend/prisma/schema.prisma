generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                @id @default(uuid()) @db.Char(36)
  fullName     String                @map("full_name") @db.VarChar(120)
  email        String                @unique @db.VarChar(254)
  phone        String                @db.VarChar(20)
  avatarUrl    String?               @map("avatar_url") @db.VarChar(500)
  passwordHash String                @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?        @map("password_changed_at") @db.DateTime(3)
  passwordResetRequired Boolean      @default(false) @map("password_reset_required")
  status       String                @default("active") @db.VarChar(32)
  language     String                @default("en") @db.VarChar(2)
  theme        String                @default("light") @db.VarChar(5)
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  roles        UserRole[]
  sessions     Session[]
  stores       Store[]               @relation("MerchantStores")
  audits       AuditRecord[]         @relation("AuditActor")
  cart         Cart?
  orders       CommerceOrder[]       @relation("CustomerOrders")
  checkouts    CheckoutTransaction[]
  platformTransactions PlatformTransaction[] @relation("PlatformTransactionCustomer")
  contributions VoluntaryContribution[] @relation("MerchantContributions")
  adminFeeSettlements AdminFeeSettlement[] @relation("MerchantSettlements")
  storeStatusChanges StoreStatusHistory[] @relation("StoreStatusChangedBy")
  tourismBookings TourismBooking[]
  tourismGroupRequests TourismGroupRequest[]
  tourismGroupOffers TourismGroupOffer[]
  liveInBookings LiveInBooking[]
  liveInGroupRequests LiveInGroupRequest[]
  liveInGroupOffers LiveInGroupOffer[]
  reviews Review[] @relation("ReviewCustomer")
  reviewReplies ReviewReply[] @relation("ReviewReplyAuthor")
  moderatedReviews Review[] @relation("ReviewModerator")
  notifications Notification[]
  conversationParticipants ConversationParticipant[]
  sentMessages Message[] @relation("MessageSender")
  messageReads MessageRead[]
  closedConversations Conversation[] @relation("ConversationCloser")
  courierProfile CourierProfile?
  courierAvailabilities CourierAvailability[] @relation("CourierAvailabilityUser")
  deliveryBatches DeliveryBatch[] @relation("DeliveryBatchCourier")
  merchantPickupConfirmations PickupConfirmation[] @relation("PickupMerchant")
  courierPickupConfirmations PickupConfirmation[] @relation("PickupCourier")
  deliveryProofs DeliveryProof[] @relation("DeliveryProofCourier")
  deliveryActivities DeliveryActivity[] @relation("DeliveryActivityCourier")

  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Char(36)
  name      String     @unique @db.VarChar(32)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Store {
  id             String          @id @default(uuid()) @db.Char(36)
  merchantUserId String          @map("merchant_user_id") @db.Char(36)
  name           String          @db.VarChar(160)
  type           StoreType
  description    String          @db.Text
  phone          String?         @db.VarChar(20)
  image          String?         @db.VarChar(1000)
  status         String          @default("active") @db.VarChar(32)
  approvalStatus String          @default("APPROVED") @map("approval_status") @db.VarChar(16)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(500)
  reviewedAt     DateTime?       @map("reviewed_at") @db.DateTime(3)
  reviewedByUserId String?       @map("reviewed_by_user_id") @db.Char(36)
  locationLabel  String?         @map("location_label") @db.VarChar(160)
  address        String?         @db.VarChar(500)
  latitude       Decimal?        @db.Decimal(9, 6)
  longitude      Decimal?        @db.Decimal(9, 6)
  locationSource String          @default("local") @map("location_source") @db.VarChar(16)
  locationRef    String?         @map("location_ref") @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  merchant       User            @relation("MerchantStores", fields: [merchantUserId], references: [id], onDelete: Restrict)
  products       Product[]
  orders         CommerceOrder[]
  initialFee     StoreInitialFee?
  platformTransactions PlatformTransaction[]
  adminFeeObligations AdminFeeObligation[]
  adminFeeSettlements AdminFeeSettlement[]
  statusHistory StoreStatusHistory[]
  tourismPackages TourismPackage[]
  liveInProfile LiveInProfile?
  reviews Review[]
  conversationContexts ConversationContext[]

  @@index([merchantUserId])
  @@index([type])
  @@map("stores")
}

model Product {
  id           String              @id @default(uuid()) @db.Char(36)
  storeId      String              @map("store_id") @db.Char(36)
  name         String              @db.VarChar(180)
  description  String              @db.Text
  category     String              @db.VarChar(100)
  status       ProductStatus       @default(active)
  hasVariants  Boolean             @default(false) @map("has_variants")
  price        Decimal?            @db.Decimal(14, 2)
  stock        Int?
  createdAt    DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  options      ProductOption[]
  variants     ProductVariant[]
  cartItems    CartItem[]
  orderItems   CommerceOrderItem[]
  reservations StockReservation[]
  conversationContexts ConversationContext[]

  @@index([storeId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Char(36)
  productId  String  @map("product_id") @db.Char(36)
  url        String  @db.VarChar(2000)
  storageKey String? @map("storage_key") @db.VarChar(500)
  position   Int
  isPrimary  Boolean @default(false) @map("is_primary")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_images")
}

model ProductOption {
  id        String  @id @default(uuid()) @db.Char(36)
  productId String  @map("product_id") @db.Char(36)
  name      String  @db.VarChar(80)
  values    Json
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, position])
  @@map("product_options")
}

model ProductVariant {
  id              String              @id @default(uuid()) @db.Char(36)
  productId       String              @map("product_id") @db.Char(36)
  sku             String              @db.VarChar(100)
  combinationKey  String              @map("combination_key") @db.VarChar(500)
  options         Json
  price           Decimal             @db.Decimal(14, 2)
  stock           Int
  status          ProductStatus       @default(active)
  imageUrl        String?             @map("image_url") @db.VarChar(2000)
  imageStorageKey String?             @map("image_storage_key") @db.VarChar(500)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  orderItems      CommerceOrderItem[]
  reservations    StockReservation[]

  @@unique([productId, sku])
  @@unique([productId, combinationKey])
  @@index([productId])
  @@map("product_variants")
}

enum ProductStatus {
  active
  inactive
}

enum StoreType {
  product
  tourism            @map("tourism")
  liveIn             @map("live-in")
}

model PlatformSettings {
  id                          String   @id @default("active") @db.VarChar(32)
  deliveryRatePerKm           Decimal  @map("delivery_rate_per_km") @db.Decimal(12, 2)
  deliveryOrderCutoffTime     String   @map("delivery_order_cutoff_time") @db.VarChar(5)
  deliveryDispatchTime        String   @map("delivery_dispatch_time") @db.VarChar(5)
  maxDailyDeliveries          Int      @map("max_daily_deliveries")
  tourismApprovalTimeoutHours Int      @map("tourism_approval_timeout_hours")
  initialStoreFeeAmount        Decimal  @default(100000) @map("initial_store_fee_amount") @db.Decimal(14, 2)
  installmentFullEnabled       Boolean  @default(true) @map("installment_full_enabled")
  installment3MonthsEnabled    Boolean  @default(true) @map("installment_3_months_enabled")
  installment6MonthsEnabled    Boolean  @default(true) @map("installment_6_months_enabled")
  installmentLateInterestPercent Decimal @default(2) @map("installment_late_interest_percent") @db.Decimal(5, 2)
  adminFeeType                 String   @default("percentage") @map("admin_fee_type") @db.VarChar(16)
  adminFeeValue                Decimal  @default(5) @map("admin_fee_value") @db.Decimal(14, 2)
  adminFeeCutoffDay            Int      @default(1) @map("admin_fee_cutoff_day")
  adminFeeGraceTime            String   @default("12:00") @map("admin_fee_grace_time") @db.VarChar(5)
  suspendStoreForOutstandingAdminFee Boolean @default(true) @map("suspend_store_for_outstanding_admin_fee")
  taxPercent                   Decimal  @default(11) @map("tax_percent") @db.Decimal(5, 2)
  voluntaryContributionEnabled Boolean @default(true) @map("voluntary_contribution_enabled")
  prideTransactionValueWeight Decimal  @default(35) @map("pride_transaction_value_weight") @db.Decimal(5, 2)
  prideTransactionCountWeight Decimal  @default(25) @map("pride_transaction_count_weight") @db.Decimal(5, 2)
  prideRatingWeight            Decimal  @default(20) @map("pride_rating_weight") @db.Decimal(5, 2)
  prideCompletionRateWeight    Decimal  @default(20) @map("pride_completion_rate_weight") @db.Decimal(5, 2)
  prideLeaderboardSize         Int      @default(7) @map("pride_leaderboard_size")
  createdAt                   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("platform_settings")
}

model AuditRecord {
  id             String   @id @default(uuid()) @db.Char(36)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String   @map("entity_id") @db.VarChar(160)
  actorId        String?  @map("actor_id") @db.Char(36)
  actorRole      String?  @map("actor_role") @db.VarChar(32)
  activityType   String   @map("activity_type") @db.VarChar(80)
  previousStatus String?  @map("previous_status") @db.VarChar(80)
  nextStatus     String?  @map("next_status") @db.VarChar(80)
  description    String   @db.Text
  reason         String?  @db.Text
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_records")
}

model Cart {
  id             String     @id @default(uuid()) @db.Char(36)
  customerUserId String     @unique @map("customer_user_id") @db.Char(36)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  customer       User       @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@map("carts")
}

model CartItem {
  id               String          @id @default(uuid()) @db.Char(36)
  cartId           String          @map("cart_id") @db.Char(36)
  productId        String          @map("product_id") @db.Char(36)
  productVariantId String?         @map("product_variant_id") @db.Char(36)
  quantity         Int
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model CheckoutTransaction {
  id             String          @id @default(uuid()) @db.Char(36)
  customerUserId String          @map("customer_user_id") @db.Char(36)
  idempotencyKey String          @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  orders         CommerceOrder[]
  customer       User            @relation(fields: [customerUserId], references: [id], onDelete: Restrict)

  @@unique([customerUserId, idempotencyKey])
  @@map("checkout_transactions")
}

model CommerceOrder {
  id                    String                  @id @default(uuid()) @db.Char(36)
  orderCode             String                  @unique @map("order_code") @db.VarChar(40)
  checkoutTransactionId String                  @map("checkout_transaction_id") @db.Char(36)
  customerUserId        String                  @map("customer_user_id") @db.Char(36)
  storeId               String                  @map("store_id") @db.Char(36)
  fulfillmentStatus     FulfillmentStatus       @default(pending) @map("fulfillment_status")
  paymentStatus         PaymentStatus           @default(pending) @map("payment_status")
  paymentMethod         PaymentMethod           @map("payment_method")
  productTotal          Decimal                 @map("product_total") @db.Decimal(14, 2)
  deliveryFee           Decimal                 @map("delivery_fee") @db.Decimal(14, 2)
  courierTip            Decimal                 @map("courier_tip") @db.Decimal(14, 2)
  totalAmount           Decimal                 @map("total_amount") @db.Decimal(14, 2)
  distanceKm            Decimal                 @map("distance_km") @db.Decimal(10, 3)
  roundedDistanceKm     Int                     @map("rounded_distance_km")
  deliveryRateSnapshot  Decimal                 @map("delivery_rate_snapshot") @db.Decimal(14, 2)
  recipientName         String                  @map("recipient_name") @db.VarChar(120)
  recipientPhone        String                  @map("recipient_phone") @db.VarChar(20)
  deliveryAddress       String                  @map("delivery_address") @db.VarChar(1000)
  deliveryLocation      Json?                   @map("delivery_location")
  cancellationReason    String?                 @map("cancellation_reason") @db.VarChar(1000)
  paymentPaidAt         DateTime?               @map("payment_paid_at") @db.DateTime(3)
  cancelledAt           DateTime?               @map("cancelled_at") @db.DateTime(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  checkoutTransaction   CheckoutTransaction     @relation(fields: [checkoutTransactionId], references: [id], onDelete: Restrict)
  customer              User                    @relation("CustomerOrders", fields: [customerUserId], references: [id], onDelete: Restrict)
  store                 Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items                 CommerceOrderItem[]
  activities            CommerceOrderActivity[]
  reservations          StockReservation[]
  paymentAttempts       PaymentAttempt[]
  platformTransaction   PlatformTransaction?
  conversationContexts  ConversationContext[]
  deliveryBatchOrders   DeliveryBatchOrder[]
  pickupConfirmations   PickupConfirmation[]
  deliveryProof         DeliveryProof?
  deliveryActivities    DeliveryActivity[]

  @@index([customerUserId])
  @@index([storeId])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id               String          @id @default(uuid()) @db.Char(36)
  orderId          String          @map("order_id") @db.Char(36)
  productId        String          @map("product_id") @db.Char(36)
  productVariantId String?         @map("product_variant_id") @db.Char(36)
  productName      String          @map("product_name") @db.VarChar(180)
  variantOptions   Json?           @map("variant_options")
  sku              String?         @db.VarChar(100)
  imageUrl         String?         @map("image_url") @db.VarChar(2000)
  storeName        String          @map("store_name") @db.VarChar(160)
  unitPrice        Decimal         @map("unit_price") @db.Decimal(14, 2)
  quantity         Int
  subtotal         Decimal         @db.Decimal(14, 2)
  order            CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reviewTarget     ProductReviewTarget?

  @@index([orderId])
  @@map("commerce_order_items")
}

model CommerceOrderActivity {
  id           String        @id @default(uuid()) @db.Char(36)
  orderId      String        @map("order_id") @db.Char(36)
  actorUserId  String?       @map("actor_user_id") @db.Char(36)
  actorType    String        @map("actor_type") @db.VarChar(32)
  activityType String        @map("activity_type") @db.VarChar(80)
  fromStatus   String?       @map("from_status") @db.VarChar(40)
  toStatus     String?       @map("to_status") @db.VarChar(40)
  description  String        @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  order        CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("commerce_order_activities")
}

model StockReservation {
  id               String            @id @default(uuid()) @db.Char(36)
  orderId          String            @map("order_id") @db.Char(36)
  productId        String            @map("product_id") @db.Char(36)
  productVariantId String?           @map("product_variant_id") @db.Char(36)
  quantity         Int
  status           ReservationStatus @default(reserved)
  reservedAt       DateTime          @default(now()) @map("reserved_at") @db.DateTime(3)
  expiresAt        DateTime?         @map("expires_at") @db.DateTime(3)
  releasedAt       DateTime?         @map("released_at") @db.DateTime(3)
  consumedAt       DateTime?         @map("consumed_at") @db.DateTime(3)
  order            CommerceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

model PaymentAttempt {
  id                    String        @id @default(uuid()) @db.Char(36)
  orderId               String?       @map("order_id") @db.Char(36)
  platformTransactionId String?       @map("platform_transaction_id") @db.Char(36)
  provider              String        @db.VarChar(32)
  providerReference     String?       @unique @map("provider_reference") @db.VarChar(100)
  paymentMethod         PaymentMethod @map("payment_method")
  status                PaymentStatus @default(pending)
  amount                Decimal       @db.Decimal(14, 2)
  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(100)
  paymentType           String?       @map("payment_type") @db.VarChar(80)
  paidAt                DateTime?     @map("paid_at") @db.DateTime(3)
  expiresAt             DateTime?     @map("expires_at") @db.DateTime(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  order                 CommerceOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  platformTransaction   PlatformTransaction? @relation(fields: [platformTransactionId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([platformTransactionId])
  @@map("payment_attempts")
}

enum PaymentMethod {
  COD
  MIDTRANS
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  cancelled
  refunded
}

enum FulfillmentStatus {
  pending
  confirmed
  processing
  readyForPickup @map("ready-for-pickup")
  pickedUp       @map("picked-up")
  onDelivery     @map("on-delivery")
  delivered
  completed
  cancelled
}

enum ReservationStatus {
  reserved
  released
  consumed
}

enum DeliveryBatchStatus {
  PLANNED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryOrderStatus {
  WAITING_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

model CourierProfile {
  userId              String   @id @map("user_id") @db.Char(36)
  maxActiveDeliveries Int      @default(30) @map("max_active_deliveries")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("courier_profiles")
}

model CourierAvailability {
  id            String    @id @default(uuid()) @db.Char(36)
  courierUserId String    @map("courier_user_id") @db.Char(36)
  startAt       DateTime  @map("start_at") @db.DateTime(3)
  endAt         DateTime? @map("end_at") @db.DateTime(3)
  reason        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  courier       User      @relation("CourierAvailabilityUser", fields: [courierUserId], references: [id], onDelete: Restrict)

  @@index([courierUserId, startAt])
  @@index([courierUserId, endAt])
  @@map("courier_availabilities")
}

model DeliveryBatch {
  id            String              @id @default(uuid()) @db.Char(36)
  courierUserId String              @map("courier_user_id") @db.Char(36)
  deliveryDate  DateTime            @map("delivery_date") @db.Date
  cutoffAt      DateTime            @map("cutoff_at") @db.DateTime(3)
  dispatchAt    DateTime            @map("dispatch_at") @db.DateTime(3)
  status        DeliveryBatchStatus @default(PLANNED)
  startedAt     DateTime?           @map("started_at") @db.DateTime(3)
  completedAt   DateTime?           @map("completed_at") @db.DateTime(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  courier       User                @relation("DeliveryBatchCourier", fields: [courierUserId], references: [id], onDelete: Restrict)
  orders        DeliveryBatchOrder[]

  @@index([courierUserId, deliveryDate])
  @@index([deliveryDate, status])
  @@map("delivery_batches")
}

model DeliveryBatchOrder {
  id                String              @id @default(uuid()) @db.Char(36)
  deliveryBatchId   String              @map("delivery_batch_id") @db.Char(36)
  commerceOrderId   String              @map("commerce_order_id") @db.Char(36)
  pickupSequence    Int?                @map("pickup_sequence")
  deliverySequence  Int?                @map("delivery_sequence")
  status            DeliveryOrderStatus @default(WAITING_PICKUP)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  batch             DeliveryBatch       @relation(fields: [deliveryBatchId], references: [id], onDelete: Restrict)
  commerceOrder     CommerceOrder       @relation(fields: [commerceOrderId], references: [id], onDelete: Restrict)

  @@unique([deliveryBatchId, commerceOrderId])
  @@index([commerceOrderId, status])
  @@index([deliveryBatchId, status])
  @@map("delivery_batch_orders")
}

model PickupConfirmation {
  id               String        @id @default(uuid()) @db.Char(36)
  commerceOrderId  String        @map("commerce_order_id") @db.Char(36)
  merchantUserId   String        @map("merchant_user_id") @db.Char(36)
  courierUserId    String        @map("courier_user_id") @db.Char(36)
  isReady          Boolean       @map("is_ready")
  note             String?       @db.Text
  confirmedAt      DateTime      @default(now()) @map("confirmed_at") @db.DateTime(3)
  commerceOrder    CommerceOrder @relation(fields: [commerceOrderId], references: [id], onDelete: Restrict)
